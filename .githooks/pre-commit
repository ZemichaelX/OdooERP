#!/usr/bin/env bash
#
# SapianERP pre-commit hook: block secrets BEFORE the commit exists.
#
# Why a hook and not just CI: a live Odoo master password reached git twice.
# The first time it was found in review and removed (PR #2); it came back. CI
# would have flagged the second one too — after the commit was already written,
# already pushed, and already in every clone. A secret's blast radius is set the
# moment it is committed, so the check has to run before that. Same lesson as
# pylint-odoo: a tool that only runs in CI is a tool that tells you what you
# already shipped.
#
# Install (once per clone):
#     ./scripts/install_hooks.sh
#
# Bypass, for the rare false positive:
#     git commit --no-verify
# If you need that, add a targeted allowlist entry to .gitleaks.toml in the same
# commit — an unexplained --no-verify is how the rule dies.

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CONFIG="${REPO_ROOT}/.gitleaks.toml"

# --- The tool must be PRESENT. Absence is a failure, not a skip. -------------
# A hook that silently passes when its scanner is missing is worse than no hook:
# it produces a green signal that can be generated by doing nothing at all.
if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'EOF'
!! pre-commit: gitleaks is NOT INSTALLED — refusing to commit.
!!
!! This hook exists because a live Odoo master password reached git twice.
!! It will not wave a commit through just because its scanner is absent.
!!
!! Install it:
!!   Windows (Git Bash):  winget install gitleaks
!!                        (or download the .exe from
!!                         https://github.com/gitleaks/gitleaks/releases and put
!!                         it on PATH)
!!   macOS:               brew install gitleaks
!!   Linux:               see https://github.com/gitleaks/gitleaks/releases
!!
!! Then re-run your commit. To bypass ONCE, knowing what you are bypassing:
!!   git commit --no-verify
EOF
  exit 1
fi

if [ ! -f "${CONFIG}" ]; then
  echo "!! pre-commit: ${CONFIG} is missing — refusing to commit without a ruleset." >&2
  exit 1
fi

# --- Scan the STAGED content, not the working tree ---------------------------
# `--staged` scans exactly what is about to be committed. Scanning the working
# tree would both miss staged-only hunks and fire on unstaged scratch files.
echo ">> pre-commit: scanning staged changes with $(gitleaks version 2>/dev/null || echo gitleaks)"
if ! gitleaks git --staged --no-banner --redact --config "${CONFIG}" "${REPO_ROOT}"; then
  cat >&2 <<'EOF'
!!
!! pre-commit: SECRET DETECTED IN STAGED CHANGES — commit blocked.
!!
!! Do NOT just unstage the file and commit the rest: if the value is real it is
!! already on your disk and possibly already in a running system. Rotate it
!! first, then remove it from the staged content.
!!
!! Per-instance secrets belong in files that are gitignored:
!!   config/odoo.runtime.conf   (admin_passwd, dbfilter)
!!   docker/.env                (DB_PASSWORD)
!! The tracked templates are config/odoo.conf.example and .env.example, and
!! they carry placeholders only.
!!
!! If this is genuinely a false positive, add a narrow rule or allowlist entry
!! to .gitleaks.toml in this same commit.
EOF
  exit 1
fi

echo ">> pre-commit: no secrets found in staged changes."
exit 0
