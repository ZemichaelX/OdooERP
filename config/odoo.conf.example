; =============================================================================
; SapianERP — Odoo server configuration TEMPLATE.
;
; THIS FILE IS TRACKED IN GIT AND MUST NEVER CONTAIN A REAL VALUE.
; It is a template only. Every per-instance secret below is a placeholder.
;
; The file docker-compose actually mounts is config/odoo.runtime.conf, which is
; gitignored. Create it once per machine:
;
;     cp config/odoo.conf.example config/odoo.runtime.conf
;
; then edit the runtime copy — never this one. scripts/provision_client.sh,
; backup.sh, restore.sh, dress_rehearsal.sh and build_demo.sh all create the
; runtime copy from THIS file if it is missing.
;
; Why the split: a template and a working file at the same tracked path is how
; a live master password reached git twice (PR #2 fixed it; it came back,
; because an operator edited the tracked file for their own instance and the
; edit rode in on a `git add -A`). The paths are now different, config/odoo.conf
; is gitignored, and a gitleaks pre-commit hook blocks the commit rather than
; reporting it afterwards. See docs/KICKOFF-engineering-hygiene.md.
; =============================================================================

[options]
; Custom addons first, then vendored third-party addons, then Odoo's bundled
; ones. /mnt/vendor holds pinned upstream code that is never edited in place —
; see vendor/README.md, and scripts/check_vendor.sh which enforces it.
addons_path = /mnt/extra-addons,/mnt/vendor,/usr/lib/python3/dist-packages/odoo/addons
data_dir = /var/lib/odoo

; --- Security / production hardening ---
; Secure by default: the database manager (/web/database/*) is disabled so a
; deployment can't expose DB create/drop/backup with the master password.
; Local dev that needs the DB manager can set this back to True in the RUNTIME
; copy.
list_db = False
; Per-instance: pin the served DB so Odoo doesn't hit the disabled selector when
; several databases exist. Left BLANK in the template — a database name is
; deployment detail, not a default. Set it in config/odoo.runtime.conf, e.g.
;   dbfilter = ^sapian_prod$
dbfilter =
; Behind Nginx/TLS.
proxy_mode = True

; --- Performance (tune per server) ---
; NOTE for test runs: Odoo HttpCase needs a single worker. Either set
; workers = 0 in the runtime copy or pass --workers=0 on the test command line.
workers = 2
limit_time_cpu = 120
limit_time_real = 240
limit_memory_hard = 2684354560
limit_memory_soft = 2147483648

; --- Database master password ---------------------------------------------
; PLACEHOLDER. Odoo does NOT expand environment variables in this file, so the
; real value has to be written literally — into config/odoo.runtime.conf, never
; here. scripts/provision_client.sh generates a strong per-tenant secret, writes
; it to the runtime copy and prints it ONCE for your vault; if you set it by
; hand instead, use a fresh random 32+ character string per instance and store
; it in the vault. Leaving CHANGEME in a running deployment is a live defect.
admin_passwd = CHANGEME

; Error monitoring: sapian_sentry stays dormant unless SENTRY_DSN is set.
server_wide_modules = base,web,sapian_sentry
