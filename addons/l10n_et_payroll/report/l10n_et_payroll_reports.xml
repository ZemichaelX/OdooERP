<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_payslip" model="ir.actions.report">
        <field name="name">Payslip</field>
        <field name="model">l10n.et.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_et_payroll.report_payslip</field>
        <field name="report_file">l10n_et_payroll.report_payslip</field>
        <field name="print_report_name">'Payslip - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_l10n_et_payslip"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_paye_declaration" model="ir.actions.report">
        <field name="name">PAYE Monthly Declaration</field>
        <field name="model">l10n.et.payroll.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_et_payroll.report_paye_declaration</field>
        <field name="report_file">l10n_et_payroll.report_paye_declaration</field>
        <field name="print_report_name">'PAYE Declaration - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_l10n_et_payroll_run"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_pension_schedule" model="ir.actions.report">
        <field name="name">Pension Remittance Schedule</field>
        <field name="model">l10n.et.payroll.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_et_payroll.report_pension_schedule</field>
        <field name="report_file">l10n_et_payroll.report_pension_schedule</field>
        <field name="print_report_name">'Pension Schedule - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_l10n_et_payroll_run"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
