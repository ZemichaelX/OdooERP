<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
      Ethiopia monthly PAYE bands — 2024/25 reform (tax-free <= 2,000; top 35% above 14,000).
      These are CONFIGURATION records with effective dates. To apply a future proclamation,
      add NEW records with a new effective_from (and set effective_to on the old ones).
      Never edit historical bands, so past payslips stay reproducible.
      VERIFY against the Ministry of Revenue before payroll go-live.
    -->
    <record id="paye_band_2024_1" model="l10n.et.paye.band">
        <field name="lower_bound">0</field>
        <field name="upper_bound">2000</field>
        <field name="rate">0.00</field>
        <field name="deduction">0</field>
        <field name="effective_from">2024-07-01</field>
    </record>
