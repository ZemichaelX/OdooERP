<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_et_allowance_type_list" model="ir.ui.view">
        <field name="name">l10n.et.allowance.type.list</field>
        <field name="model">l10n.et.allowance.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="rule" widget="badge"
                       decoration-danger="rule == 'taxable'"
                       decoration-success="rule == 'exempt'"
                       decoration-warning="rule == 'capped'"/>
                <field name="cap_amount" optional="show"/>
                <field name="cap_salary_pct" widget="percentage" optional="show"/>
                <field name="source_note" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_et_allowance_type_form" model="ir.ui.view">
        <field name="name">l10n.et.allowance.type.form</field>
        <field name="model">l10n.et.allowance.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="rule" widget="radio"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="cap_amount" invisible="rule != 'capped'"/>
                            <field name="cap_salary_pct" widget="percentage"
                                   invisible="rule != 'capped'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="source_note"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_et_allowance_type" model="ir.actions.act_window">
        <field name="name">Allowance Types</field>
        <field name="res_model">l10n.et.allowance.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure allowance exemption rules</p>
            <p>Statutory defaults (transport / hardship / medical / housing /
            position) are seeded automatically with their legal sources.</p>
        </field>
    </record>

    <menuitem id="menu_l10n_et_allowance_type"
              action="action_l10n_et_allowance_type"
              parent="menu_l10n_et_payroll_root"
              sequence="30"
              groups="hr.group_hr_manager"/>
</odoo>
