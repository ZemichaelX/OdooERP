<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ethiopian statutory identifiers on the employee HR Settings tab. -->
    <record id="view_employee_form_l10n_et" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n.et.identifiers</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="inside">
                <group string="Ethiopian Statutory Identifiers"
                       groups="hr.group_hr_user">
                    <field name="l10n_et_tin"/>
                    <field name="l10n_et_pension_id"/>
                    <field name="l10n_et_pension_opt_in"
                           invisible="not country_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
