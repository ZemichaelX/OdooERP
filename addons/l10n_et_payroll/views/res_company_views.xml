<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payroll posting configuration on the company form. Auto-resolved from
         the Ethiopian chart template when left empty; visible to accounting
         managers only. -->
    <record id="view_company_form_l10n_et_payroll" model="ir.ui.view">
        <field name="name">res.company.form.l10n.et.payroll</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Ethiopian Payroll" name="l10n_et_payroll"
                      groups="account.group_account_manager">
                    <group>
                        <group string="Journal">
                            <field name="l10n_et_payroll_journal_id"/>
                        </group>
                        <group string="Expense Accounts">
                            <field name="l10n_et_salary_expense_account_id"/>
                            <field name="l10n_et_pension_expense_account_id"/>
                        </group>
                        <group string="Payable Accounts">
                            <field name="l10n_et_paye_payable_account_id"/>
                            <field name="l10n_et_pension_payable_account_id"/>
                            <field name="l10n_et_net_wages_account_id"/>
                            <field name="l10n_et_payroll_deduction_account_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
