<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The login page.

         Verified against 19.0 rather than assumed: the template is
         `web.login_layout`, declared at web/views/webclient_templates.xml:110.
         (`website.login_layout` also exists and is a different thing — it is
         the website module's wrapper, and inheriting it would do nothing on a
         database without `website` installed.)

         The sign-in button needs no rule here: it is `.btn-primary`, so it is
         already brand-coloured through $o-brand-primary. White on brand is
         4.77:1, which passes WCAG AA for normal text. -->
    <template id="login_layout_sapian" inherit_id="web.login_layout"
              name="SapianERP login branding">

        <!-- Logo: degrade to the company name rather than to Odoo's stock
             placeholder. `/web/binary/company_logo` always returns an image —
             Odoo's own logo when the company has set none — so a fresh
             database would otherwise greet a prospect with someone else's
             branding. Checking the field lets us render text instead. -->
        <xpath expr="//div[hasclass('text-center')][hasclass('pb-3')]" position="replace">
            <t t-set="sapian_company"
               t-value="env['res.company'].sudo().search([], order='id', limit=1)"/>
            <div class="text-center pb-3 border-bottom mb-4">
                <img t-if="sapian_company.logo"
                     t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
                     alt="Logo" style="max-height:120px; max-width: 100%; width:auto"/>
                <h1 t-else="" class="h4 fw-bold mb-0 text-truncate"
                    t-esc="sapian_company.name or ''"/>
            </div>
        </xpath>

        <!-- Support contact line.

             Configurable, never hard-coded: the system parameter
             `sapian_theme.support_contact` holds whatever the deployment wants
             to show — a phone number, a Telegram handle, an email. It is
             deliberately free text: support channels differ per client and per
             sector, and this module is horizontal.

             Empty state renders NOTHING — no empty box, no stray separator.
             That is what the t-if on the whole block is for. -->
        <xpath expr="//div[hasclass('card-body')]" position="inside">
            <t t-set="sapian_support"
               t-value="env['ir.config_parameter'].sudo().get_param('sapian_theme.support_contact')"/>
            <div t-if="sapian_support" class="text-center small text-muted mt-3">
                <span>Support:</span>
                <span t-esc="sapian_support"/>
            </div>
        </xpath>

    </template>

</odoo>
