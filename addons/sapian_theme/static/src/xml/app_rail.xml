<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!--
        A flat list of rows, icon + label. No grouping, no "more" affordance, no
        truncation: every installed app is here, in menu-sequence order, and the
        rail scrolls when they do not fit. See README.md, "36 apps and 900
        pixels", for why that is the trade-off and what it costs.

        THE SCROLL CONTAINER IS STILL <nav> ITSELF, and deliberately so. The
        obvious structure for a rail with a pinned toggle is nav > [header] +
        [scrolling list], but that would move scrollTop/scrollHeight onto an
        inner element, and TestSapianAppRailOverflow and
        TestSapianAppRailKeepsScroll both measure them on `.o_sapian_rail`.
        Those two tests are the only reason we know the rail neither truncates
        at 40 apps nor loses the user's scroll position on a re-render; a
        structural change that quietly moved what they measure would leave them
        green and measuring the wrong box. The toggle is `position: sticky`
        instead, which pins it without moving the scroll.

        `d-none` is NOT used to hide below md. Bootstrap's display utilities
        leave the element in the DOM, and the padding rule that makes room for
        the rail keys off `:has(.o_sapian_rail)` — so a display utility would
        indent the web client by the rail's width while showing nothing in the
        gap. Both rules live inside one media query in sapian_rail.scss instead,
        where they cannot disagree.
    -->
    <t t-name="sapian_theme.AppRail">
        <nav t-if="!state.fullscreen" class="o_sapian_rail" t-ref="rail"
             t-att-class="{ o_sapian_rail_collapsed: state.collapsed }"
             aria-label="Applications">

            <!--
                THE BRAND IS THE HEADER, and the header is the toggle.

                What sat here before was whatever the first app happened to be
                — on our databases sapian_core's app icon, because SapianERP is
                menu sequence 5. The first thing anyone sees was therefore an
                icon that means "the SapianERP configuration app", not the
                product's mark. It is the real logo now.

                The four paths are the EXACT `d` attributes from
                brand/Sapian Logo.svg, the same ones views/sapian_mark.xml
                carries — this is a second RENDERING, not a second source.
                A server-side QWeb template cannot be `t-call`ed from an OWL
                one, so the shape has to appear twice; the test asserts BOTH
                copies against the committed file, so neither can drift.
                brand/README.md: "Never recreate or trace them."

                Monochrome and `fill="currentColor"` for the same reason as the
                login mark: the colour comes from the palette through `color`,
                and there is no hex here to go stale.

                It is a <button> because it toggles: the brand area collapsing
                the sidebar is a common pattern, it keeps the control at the
                top where it cannot scroll away, and it costs no extra row in a
                panel that is already 1,634px of content at 36 apps. The
                chevron carries the affordance when expanded; the tooltip
                carries it when collapsed. A real <button>, so it is in the tab
                order and answers to Enter and Space with no key handling of
                our own; `aria-expanded` is what a screen reader reads.
            -->
            <!--
                `aria-expanded` is written as the STRINGS 'true'/'false', not
                as the boolean. Measured on the running client with the boolean
                form: expanded rendered `aria-expanded=""` and collapsed
                rendered no attribute at all, because OWL's `t-att` stringifies
                true to the empty string and drops the attribute on false. An
                empty value is not a valid ARIA state and a missing one means
                "this control does not expand anything" — the exact opposite of
                what the collapsed rail should announce.
                TestSapianSidebarHeader asserts both literal values.
            -->
            <button type="button" class="o_sapian_rail_toggle"
                    t-att-aria-expanded="state.collapsed ? 'false' : 'true'"
                    t-att-aria-label="state.collapsed ? 'Expand the app sidebar' : 'Collapse the app sidebar'"
                    t-att-data-tooltip="state.collapsed ? 'SapianERP — expand' : 'Collapse'"
                    data-tooltip-position="right"
                    t-on-click="() => this.toggleCollapsed()">
                <svg viewBox="0 0 512 512" fill="currentColor" aria-hidden="true"
                     focusable="false" class="o_sapian_mark o_sapian_rail_brand"
                     xmlns="http://www.w3.org/2000/svg">
                     <path d="M250.88 250.88C235.52 184.32 225.28 122.88 204.8 92.1602C184.32 61.4402 138.24 61.4402 107.52 87.0402C61.44 122.88 56.32 189.44 81.92 235.52C97.28 261.12 128 276.48 158.72 271.36C174.08 268.8 179.2 256 174.08 240.64C168.96 225.28 184.32 215.04 204.8 220.16C225.28 225.28 240.64 240.64 250.88 250.88Z"/>
                     <path d="M261.12 250.88C327.68 235.52 389.12 225.28 419.84 204.8C450.56 184.32 450.56 138.24 424.96 107.52C389.12 61.44 322.56 56.32 276.48 81.92C250.88 97.28 235.52 128 240.64 158.72C243.2 174.08 256 179.2 271.36 174.08C286.72 168.96 296.96 184.32 291.84 204.8C286.72 225.28 271.36 240.64 261.12 250.88Z"/>
                     <path d="M261.12 261.12C276.48 327.68 286.72 389.12 307.2 419.84C327.68 450.56 373.76 450.56 404.48 424.96C450.56 389.12 455.68 322.56 430.08 276.48C414.72 250.88 384 235.52 353.28 240.64C337.92 243.2 332.8 256 337.92 271.36C343.04 286.72 327.68 296.96 307.2 291.84C286.72 286.72 271.36 271.36 261.12 261.12Z"/>
                     <path d="M250.88 261.12C184.32 276.48 122.88 286.72 92.1602 307.2C61.4402 327.68 61.4402 373.76 87.0402 404.48C122.88 450.56 189.44 455.68 235.52 430.08C261.12 414.72 276.48 384 271.36 353.28C268.8 337.92 256 332.8 240.64 337.92C225.28 343.04 215.04 327.68 220.16 307.2C225.28 286.72 240.64 271.36 250.88 261.12Z"/>
                </svg>
                <span class="o_sapian_rail_label">SapianERP</span>
                <i class="fa fa-fw o_sapian_rail_chevron" role="img"
                   t-att-class="state.collapsed ? 'fa-angle-double-right' : 'fa-angle-double-left'"/>
            </button>

            <a t-foreach="apps" t-as="app" t-key="app.id"
               class="o_sapian_rail_app"
               t-att-class="{ o_sapian_rail_app_active: currentApp and currentApp.id === app.id }"
               t-att-href="hrefFor(app)"
               t-att-aria-label="app.name"
               t-att-aria-current="currentApp and currentApp.id === app.id ? 'page' : undefined"
               t-att-data-menu-xmlid="app.xmlid"
               t-att-data-tooltip="state.collapsed ? app.name : undefined"
               data-tooltip-position="right"
               t-on-click.prevent="() => this.onAppClick(app)">
                <img t-if="app.webIconData" class="o_sapian_rail_icon"
                     t-att-src="app.webIconData" t-att-alt="app.name"/>
                <!--
                    Same degradation as the login page: when there is no image,
                    fall back to the NAME rather than to a broken <img> or a
                    stock placeholder. An app in this state is a defect —
                    load_web_menus already substitutes Odoo's default icon when
                    a menu has none — so the rail's own test asserts that this
                    branch is taken zero times.
                -->
                <span t-else="" class="o_sapian_rail_initial"
                      t-esc="app.name.trim().slice(0, 2)"/>
                <!--
                    The label is always in the DOM and hidden by CSS when
                    collapsed, never removed. Two reasons: collapsing must not
                    change the tile count that TestSapianAppRailRendered checks
                    against load_menus, and a label that exists only in one
                    state is a label that stops being translated in the other.
                -->
                <span class="o_sapian_rail_label" t-esc="app.name"/>
            </a>
        </nav>
    </t>

</templates>
