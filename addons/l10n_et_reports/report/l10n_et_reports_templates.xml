<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Monthly VAT declaration (branded via web.external_layout). Section-level
         MoR alignment; verify the exact official form layout before filing. -->
    <template id="report_vat_declaration">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="data" t-value="o._get_report_data()"/>
                        <h2><span t-field="o.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Taxpayer:</strong> <span t-field="o.company_id.name"/><br/>
                                TIN: <span t-out="o.company_id.partner_id.l10n_et_tin or '—'"/>
                            </div>
                            <div class="col-6">
                                <strong>Period:</strong>
                                <span t-field="o.date_from"/> – <span t-field="o.date_to"/>
                                (monthly, Proc 1341/2024)
                            </div>
                        </div>

                        <div t-if="not data['tie_out_ok']" class="alert alert-warning mt-3" role="alert">
                            <strong>Fix before filing — report does not tie to the general ledger:</strong>
                            <ul>
                                <li t-foreach="[tie for tie in data['tie_out'] if not tie['ok']]" t-as="tie">
                                    <span t-out="tie['label']"/> (accounts <span t-out="tie['accounts']"/>):
                                    report <span t-out="'%.2f' % tie['report_total']"/> vs
                                    GL <span t-out="'%.2f' % tie['gl_total']"/> —
                                    difference <span t-out="'%.2f' % tie['difference']"/>
                                </li>
                            </ul>
                        </div>

                        <h5 class="mt-4">Output VAT (sales)</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Row</th><th class="text-end">Taxable Base</th><th class="text-end">VAT</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['output_rows']" t-as="row">
                                    <td><span t-out="row['label']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % row['base']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % row['amount']"/></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Total output VAT</td>
                                    <td class="text-end"><span t-out="'%.2f' % data['output_total_base']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % data['output_total_tax']"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h5 class="mt-3">Input VAT (purchases)</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Row</th><th class="text-end">Taxable Base</th><th class="text-end">VAT</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['input_rows']" t-as="row">
                                    <td><span t-out="row['label']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % row['base']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % row['amount']"/></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>Total input VAT (creditable)</td>
                                    <td class="text-end"><span t-out="'%.2f' % data['input_total_base']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % data['input_total_tax']"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="row justify-content-end mt-3">
                            <div class="col-6">
                                <table class="table table-sm">
                                    <tr class="fw-bold border-top">
                                        <td>
                                            <span t-if="data['is_payable']">NET VAT PAYABLE to MoR</span>
                                            <span t-else="">NET VAT CREDIT carried forward</span>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="'%.2f' % abs(data['net_vat'])"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <h6 class="mt-4">Reconciliation to general ledger</h6>
                        <table class="table table-sm">
                            <thead>
                                <tr><th>Check</th><th>Accounts</th><th class="text-end">Report</th><th class="text-end">GL</th><th class="text-center">Status</th></tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['tie_out']" t-as="tie">
                                    <td><span t-out="tie['label']"/></td>
                                    <td><span t-out="tie['accounts']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % tie['report_total']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % tie['gl_total']"/></td>
                                    <td class="text-center">
                                        <span t-if="tie['ok']" class="text-success">OK</span>
                                        <strong t-else="" class="text-danger">MISMATCH</strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-muted">
                            Computed from posted journal items via the Ethiopian tax
                            codes. Verify the row layout against the current MoR VAT
                            return form before filing.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- WHT summary: per-bill rows, MISSING markers, remittance deadline note. -->
    <template id="report_wht_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="data" t-value="o._get_report_data()"/>
                        <h2><span t-field="o.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Withholding Agent:</strong> <span t-field="o.company_id.name"/><br/>
                                TIN: <span t-out="o.company_id.partner_id.l10n_et_tin or '—'"/>
                            </div>
                            <div class="col-6">
                                <strong>Period:</strong>
                                <span t-field="o.date_from"/> – <span t-field="o.date_to"/><br/>
                                <strong>Remit withheld amounts to MoR within 30 days of month end.</strong>
                            </div>
                        </div>

                        <div t-if="data['warnings'] or not data['tie_out_ok']"
                             class="alert alert-warning mt-3" role="alert">
                            <strong>Fix before filing:</strong>
                            <ul>
                                <li t-foreach="data['warnings']" t-as="warning">
                                    <span t-out="warning"/>
                                </li>
                                <li t-foreach="[tie for tie in data['tie_out'] if not tie['ok']]" t-as="tie">
                                    <span t-out="tie['label']"/>: report
                                    <span t-out="'%.2f' % tie['report_total']"/> vs GL
                                    <span t-out="'%.2f' % tie['gl_total']"/> — difference
                                    <span t-out="'%.2f' % tie['difference']"/>
                                </li>
                            </ul>
                        </div>

                        <table class="table table-sm mt-3">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Reference</th>
                                    <th>Supplier</th>
                                    <th>TIN</th>
                                    <th class="text-end">Rate</th>
                                    <th class="text-end">Base</th>
                                    <th class="text-end">WHT</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['rows']" t-as="row">
                                    <td><span t-out="row['date']"/></td>
                                    <td><span t-out="row['move'].name"/></td>
                                    <td><span t-out="row['supplier']"/></td>
                                    <td>
                                        <span t-if="row['tin']" t-out="row['tin']"/>
                                        <span t-elif="row['kind'] == 'foreign_digital'"
                                              class="text-muted">N/A (foreign)</span>
                                        <strong t-else="" class="text-danger">MISSING</strong>
                                    </td>
                                    <td class="text-end"><span t-out="'%.0f' % row['rate']"/>%</td>
                                    <td class="text-end"><span t-out="'%.2f' % row['base']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % row['amount']"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr t-foreach="data['totals_by_rate'].items()" t-as="rate_total">
                                    <td colspan="5" class="text-end">
                                        Total at <span t-out="'%.0f' % rate_total[0]"/>%
                                    </td>
                                    <td/>
                                    <td class="text-end"><span t-out="'%.2f' % rate_total[1]"/></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td colspan="5" class="text-end">GRAND TOTAL withheld</td>
                                    <td/>
                                    <td class="text-end"><span t-out="'%.2f' % data['grand_total']"/></td>
                                </tr>
                            </tfoot>
                        </table>

                        <h6 class="mt-4">Reconciliation to general ledger</h6>
                        <table class="table table-sm">
                            <tbody>
                                <tr t-foreach="data['tie_out']" t-as="tie">
                                    <td><span t-out="tie['label']"/> (accounts <span t-out="tie['accounts']"/>)</td>
                                    <td class="text-end"><span t-out="'%.2f' % tie['report_total']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % tie['gl_total']"/></td>
                                    <td class="text-center">
                                        <span t-if="tie['ok']" class="text-success">OK</span>
                                        <strong t-else="" class="text-danger">MISMATCH</strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-muted">
                            Foreign providers: no local TIN required. Verify the
                            schedule layout against the current MoR form before filing.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Profit and loss. Sections come from ACCOUNT TYPES (set in the chart by
         l10n_et_base), never from prefixes hard-coded here. The two checks at
         the foot are part of the statement, not an appendix: an accountant who
         signs this needs to see that it reconciles and that nothing fell out. -->
    <template id="report_profit_loss">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="data" t-value="o._get_report_data()"/>
                        <h2><span t-field="o.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Company:</strong> <span t-field="o.company_id.name"/><br/>
                                TIN: <span t-out="o.company_id.partner_id.l10n_et_tin or '&#8212;'"/>
                            </div>
                            <div class="col-6">
                                <strong>Period:</strong>
                                <span t-field="o.date_from"/> &#8211; <span t-field="o.date_to"/><br/>
                                Currency: <span t-field="o.currency_id.name"/>
                            </div>
                        </div>

                        <t t-set="mismatches" t-value="[tie for tie in data['tie_out'] if not tie['ok']]"/>
                        <div t-if="not data['tie_out_ok']" class="alert alert-warning mt-3" role="alert">
                            <strong t-if="mismatches">
                                This statement does not reconcile to the general ledger — read before
                                relying on it:
                            </strong>
                            <strong t-else="">
                                This statement reconciles to the general ledger, but an account in the
                                chart of accounts is not yet classified:
                            </strong>
                            <ul>
                                <li t-foreach="mismatches" t-as="tie">
                                    <span t-out="tie['label']"/>:
                                    statement <span t-out="'%.2f' % tie['report_total']"/> vs
                                    GL <span t-out="'%.2f' % tie['gl_total']"/> &#8212;
                                    difference <span t-out="'%.2f' % tie['difference']"/>
                                </li>
                                <li t-foreach="data['warnings']" t-as="warning">
                                    <span t-out="warning"/>
                                </li>
                            </ul>
                        </div>

                        <table class="table table-sm mt-3">
                            <thead>
                                <tr>
                                    <th>Account</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="data['sections']" t-as="section">
                                    <tr class="table-light">
                                        <td colspan="2"><strong t-out="section['label']"/></td>
                                    </tr>
                                    <tr t-foreach="section['accounts']" t-as="row">
                                        <td class="ps-4">
                                            <span t-out="row['code']"/> <span t-out="row['name']"/>
                                            <span t-if="row.get('reason')" class="text-muted">
                                                &#8212; <span t-out="row['reason']"/>
                                            </span>
                                        </td>
                                        <td class="text-end"><span t-out="'%.2f' % row['amount']"/></td>
                                    </tr>
                                    <tr t-if="not section['accounts']">
                                        <td class="ps-4 text-muted">No movement in the period</td>
                                        <td class="text-end">0.00</td>
                                    </tr>
                                    <tr class="fw-bold">
                                        <td>Total <span t-out="section['label']"/></td>
                                        <td class="text-end"><span t-out="'%.2f' % section['total']"/></td>
                                    </tr>
                                    <tr t-if="section.get('subtotal')" class="fw-bold border-top">
                                        <td><span t-out="section['subtotal']"/></td>
                                        <td class="text-end">
                                            <span t-out="'%.2f' % section['subtotal_amount']"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="fw-bold border-top">
                                    <td>NET PROFIT FOR THE PERIOD</td>
                                    <td class="text-end"><span t-out="'%.2f' % data['net_profit']"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <h6 class="mt-4">Reconciliation and coverage</h6>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Check</th>
                                    <th class="text-end">Statement</th>
                                    <th class="text-end">Ledger</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['tie_out']" t-as="tie">
                                    <td><span t-out="tie['label']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % tie['report_total']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % tie['gl_total']"/></td>
                                    <td class="text-center">
                                        <span t-if="tie['ok']" class="text-success">OK</span>
                                        <strong t-else="" class="text-danger">MISMATCH</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Accounts classified
                                        <div t-if="not data['classification']['ok']" class="text-danger">
                                            <span t-out="data['classification']['message']"/>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="data['classification']['classified']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="data['classification']['total']"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-if="data['classification']['ok']" class="text-success">OK</span>
                                        <strong t-else="" class="text-danger">UNCLASSIFIED</strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-muted">
                            Computed live from posted journal items. Sections follow the
                            account types set on the chart of accounts; an account no
                            section claims is listed above by name and excluded from the
                            totals, so the reconciliation fails rather than hiding it.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Balance sheet. Sections come from ACCOUNT TYPES (set in the chart by
         l10n_et_base); the three checks at the foot are part of the statement,
         because an accountant who signs it needs to see that it balances, that
         it agrees with the profit & loss, and that nothing fell out of it. -->
    <template id="report_balance_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <t t-set="data" t-value="o._get_report_data()"/>
                        <t t-set="mismatches" t-value="[tie for tie in data['tie_out'] if not tie['ok']]"/>
                        <h2><span t-field="o.name"/></h2>
                        <div class="row mt-3">
                            <div class="col-6">
                                <strong>Company:</strong> <span t-field="o.company_id.name"/><br/>
                                TIN: <span t-out="o.company_id.partner_id.l10n_et_tin or '&#8212;'"/>
                            </div>
                            <div class="col-6">
                                <strong>As at:</strong> <span t-field="o.date_to"/><br/>
                                Result measured from <span t-field="o.date_from"/><br/>
                                Currency: <span t-field="o.currency_id.name"/>
                            </div>
                        </div>

                        <div t-if="not data['tie_out_ok']" class="alert alert-warning mt-3" role="alert">
                            <strong t-if="mismatches">
                                This statement does not balance &#8212; read before relying on it:
                            </strong>
                            <strong t-else="">
                                This statement balances, but an account in the chart of accounts is
                                not yet classified:
                            </strong>
                            <ul>
                                <li t-foreach="mismatches" t-as="tie">
                                    <span t-out="tie['label']"/>:
                                    <span t-out="'%.2f' % tie['report_total']"/> vs
                                    <span t-out="'%.2f' % tie['gl_total']"/> &#8212;
                                    difference <span t-out="'%.2f' % tie['difference']"/>
                                </li>
                                <li t-foreach="data['warnings']" t-as="warning">
                                    <span t-out="warning"/>
                                </li>
                            </ul>
                        </div>

                        <table class="table table-sm mt-3">
                            <thead>
                                <tr><th>Account</th><th class="text-end">Amount</th></tr>
                            </thead>
                            <tbody>
                                <t t-set="last_group" t-value="None"/>
                                <t t-foreach="data['sections']" t-as="section">
                                    <tr t-if="section.get('group') and section['group'] != last_group">
                                        <td colspan="2" class="border-top">
                                            <h5 class="mb-0"><span t-out="section['group']"/></h5>
                                        </td>
                                    </tr>
                                    <t t-set="last_group" t-value="section.get('group')"/>
                                    <tr class="table-light">
                                        <td colspan="2"><strong t-out="section['label']"/></td>
                                    </tr>
                                    <tr t-foreach="section['accounts']" t-as="row">
                                        <td class="ps-4">
                                            <span t-out="row['code']"/> <span t-out="row['name']"/>
                                            <span t-if="row.get('reason')" class="text-muted">
                                                &#8212; <span t-out="row['reason']"/>
                                            </span>
                                        </td>
                                        <td class="text-end"><span t-out="'%.2f' % row['amount']"/></td>
                                    </tr>
                                    <tr t-if="not section['accounts']">
                                        <td class="ps-4 text-muted">Nothing on these accounts</td>
                                        <td class="text-end">0.00</td>
                                    </tr>
                                    <tr class="fw-bold">
                                        <td>Total <span t-out="section['label']"/></td>
                                        <td class="text-end"><span t-out="'%.2f' % section['total']"/></td>
                                    </tr>
                                </t>
                                <tr t-foreach="data['equity_lines']" t-as="line">
                                    <td class="ps-4"><span t-out="line['label']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % line['amount']"/></td>
                                </tr>
                                <tr class="fw-bold border-top">
                                    <td>TOTAL ASSETS</td>
                                    <td class="text-end"><span t-out="'%.2f' % data['total_assets']"/></td>
                                </tr>
                                <tr class="fw-bold">
                                    <td>TOTAL LIABILITIES AND EQUITY</td>
                                    <td class="text-end">
                                        <span t-out="'%.2f' % data['total_liabilities_and_equity']"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <h6 class="mt-4">Reconciliation and coverage</h6>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Check</th>
                                    <th class="text-end">This statement</th>
                                    <th class="text-end">Compared with</th>
                                    <th class="text-center">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="data['tie_out']" t-as="tie">
                                    <td><span t-out="tie['label']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % tie['report_total']"/></td>
                                    <td class="text-end"><span t-out="'%.2f' % tie['gl_total']"/></td>
                                    <td class="text-center">
                                        <span t-if="tie['ok']" class="text-success">OK</span>
                                        <strong t-else="" class="text-danger">MISMATCH</strong>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        Accounts classified
                                        <div t-if="not data['classification']['ok']" class="text-danger">
                                            <span t-out="data['classification']['message']"/>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="data['classification']['classified']"/>
                                    </td>
                                    <td class="text-end">
                                        <span t-out="data['classification']['total']"/>
                                    </td>
                                    <td class="text-center">
                                        <span t-if="data['classification']['ok']" class="text-success">OK</span>
                                        <strong t-else="" class="text-danger">UNCLASSIFIED</strong>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-muted">
                            Computed live from posted journal items up to the closing date.
                            Sections follow the account types set on the chart of accounts;
                            an account no section claims is listed above by name and excluded
                            from the totals, so the statement fails to balance rather than
                            hiding it. Off-balance-sheet accounts are excluded by definition
                            and their count is reported above when any exist.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
