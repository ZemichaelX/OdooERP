<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_l10n_et_vat_declaration_list" model="ir.ui.view">
        <field name="name">l10n.et.vat.declaration.list</field>
        <field name="model">l10n.et.vat.declaration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="output_vat_total" sum="Total"/>
                <field name="input_vat_total" sum="Total"/>
                <field name="net_vat" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_et_vat_declaration_form" model="ir.ui.view">
        <field name="name">l10n.et.vat.declaration.form</field>
        <field name="model">l10n.et.vat.declaration</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print_pdf" type="object"
                            string="Print PDF" class="btn-primary"/>
                    <button name="action_export_csv" type="object"
                            string="Export CSV"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <field name="off_chart" invisible="1"/>
                    <div class="alert alert-warning" role="alert" invisible="not off_chart">
                        This company is not on the Ethiopian chart of accounts —
                        no VAT tax codes resolve, so all figures are zero. Load
                        the Ethiopian chart of accounts before filing.
                    </div>
                    <group>
                        <group string="Period">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Totals (live from posted moves)">
                            <field name="output_vat_total"/>
                            <field name="input_vat_total"/>
                            <field name="net_vat"/>
                            <field name="csv_export_file"
                                   filename="csv_export_filename"
                                   invisible="not csv_export_file"/>
                            <field name="csv_export_filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_et_wht_summary_list" model="ir.ui.view">
        <field name="name">l10n.et.wht.summary.list</field>
        <field name="model">l10n.et.wht.summary</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="total_wht" sum="Total"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_et_wht_summary_form" model="ir.ui.view">
        <field name="name">l10n.et.wht.summary.form</field>
        <field name="model">l10n.et.wht.summary</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print_pdf" type="object"
                            string="Print PDF" class="btn-primary"/>
                    <button name="action_export_csv" type="object"
                            string="Export CSV"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Period">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Totals (live from posted moves)">
                            <field name="total_wht"/>
                            <field name="csv_export_file"
                                   filename="csv_export_filename"
                                   invisible="not csv_export_file"/>
                            <field name="csv_export_filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_l10n_et_profit_loss_list" model="ir.ui.view">
        <field name="name">l10n.et.profit.loss.list</field>
        <field name="model">l10n.et.profit.loss</field>
        <field name="arch" type="xml">
            <list decoration-danger="not tie_out_ok">
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="gross_profit" sum="Total"/>
                <field name="net_profit" sum="Total"/>
                <field name="tie_out_ok" string="Ties"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_l10n_et_profit_loss_form" model="ir.ui.view">
        <field name="name">l10n.et.profit.loss.form</field>
        <field name="model">l10n.et.profit.loss</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_print_pdf" type="object"
                            string="Print PDF" class="btn-primary"/>
                    <button name="action_export_csv" type="object"
                            string="Export CSV"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <field name="tie_out_ok" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="tie_out_ok">
                        Either this statement does not reconcile to the general
                        ledger, or an account in the chart of accounts is not yet
                        classified. Print the PDF or export the CSV to see which —
                        the reconciliation block says so in words.
                    </div>
                    <group>
                        <group string="Period">
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="company_id"
                                   groups="base.group_multi_company"/>
                        </group>
                        <group string="Totals (live from posted moves)">
                            <field name="gross_profit"/>
                            <field name="net_profit"/>
                            <field name="csv_export_file"
                                   filename="csv_export_filename"
                                   invisible="not csv_export_file"/>
                            <field name="csv_export_filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_et_vat_declaration" model="ir.actions.act_window">
        <field name="name">VAT Declarations</field>
        <field name="res_model">l10n.et.vat.declaration</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a monthly VAT declaration period.
            </p><p>
                Figures are computed live from posted moves and tied out to the
                general ledger — reprint any time.
            </p>
        </field>
    </record>

    <record id="action_l10n_et_wht_summary" model="ir.actions.act_window">
        <field name="name">WHT Summaries</field>
        <field name="res_model">l10n.et.wht.summary</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a withholding tax summary period.
            </p><p>
                One row per vendor bill per rate, tied out to the WHT payable
                account. Remit within 30 days of month end.
            </p>
        </field>
    </record>

    <record id="action_l10n_et_profit_loss" model="ir.actions.act_window">
        <field name="name">Profit and Loss</field>
        <field name="res_model">l10n.et.profit.loss</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a profit and loss period.
            </p><p>
                Sections follow the account types on the chart of accounts, and
                the statement reconciles itself to the general ledger every time
                it is printed. An account no section claims is named on the face
                of the report rather than swept into "other expenses".
            </p>
        </field>
    </record>

    <!-- TOP-LEVEL APP, renamed from "Ethiopian Statutory Reports".
         "Compliance" is what the buyer is actually buying — VAT declarations,
         WHT summaries and filings are the obligation, the reports are just how
         it is discharged. Sitting beside Sales and Inventory it states what the
         product does; buried under Accounting > Reporting it stated only that
         we print things.
         NOTE: `parent` is absent, not blank — see the payroll menu for why that
         distinction matters on an existing database. -->
    <menuitem id="menu_l10n_et_reports"
              name="Ethiopian Compliance"
              sequence="50"
              web_icon="l10n_et_reports,static/description/icon.png"/>
    <menuitem id="menu_l10n_et_vat_declaration"
              action="action_l10n_et_vat_declaration"
              parent="menu_l10n_et_reports"
              sequence="10"/>
    <menuitem id="menu_l10n_et_wht_summary"
              action="action_l10n_et_wht_summary"
              parent="menu_l10n_et_reports"
              sequence="20"/>
    <menuitem id="menu_l10n_et_profit_loss"
              action="action_l10n_et_profit_loss"
              parent="menu_l10n_et_reports"
              sequence="30"/>
</odoo>
