<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company isolation: configuration records are only visible/editable
         within the user's allowed companies (CLAUDE.md rule #3). -->
    <record id="l10n_et_wht_config_company_rule" model="ir.rule">
        <field name="name">Ethiopian WHT Config: multi-company</field>
        <field name="model_id" ref="model_l10n_et_wht_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_et_cash_cap_config_company_rule" model="ir.rule">
        <field name="name">Ethiopian Cash Cap Config: multi-company</field>
        <field name="model_id" ref="model_l10n_et_cash_cap_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="l10n_et_swl_config_company_rule" model="ir.rule">
        <field name="name">Ethiopian Social Welfare Levy Config: multi-company</field>
        <field name="model_id" ref="model_l10n_et_social_welfare_levy_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
