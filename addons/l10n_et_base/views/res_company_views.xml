<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_l10n_et_base" model="ir.ui.view">
        <field name="name">res.company.form.l10n.et.base</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Ethiopian Taxes" name="l10n_et_base">
                    <field name="l10n_et_tax_engine_active"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
