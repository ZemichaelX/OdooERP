<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company isolation (CLAUDE.md rule #3). -->
    <record id="pharma_import_dossier_company_rule" model="ir.rule">
        <field name="name">Pharma Import Dossier: multi-company</field>
        <field name="model_id" ref="model_pharma_import_dossier"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
