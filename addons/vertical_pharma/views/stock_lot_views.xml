<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_list_pharma" model="ir.ui.view">
        <field name="name">stock.lot.list.pharma</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="pharma_state" widget="badge" optional="show"
                       decoration-success="pharma_state == 'fresh'"
                       decoration-warning="pharma_state == 'nearing_expiry'"
                       decoration-danger="pharma_state == 'expired'"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_lot_form_pharma" model="ir.ui.view">
        <field name="name">stock.lot.form.pharma</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(action_report_pharma_recall)d" type="action"
                            string="Recall Report" class="btn-secondary"
                            invisible="not is_pharma"
                            help="Every customer who received this batch, with contact details."/>
                </header>
            </xpath>
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="pharma_state" widget="badge" invisible="not is_pharma"
                       decoration-success="pharma_state == 'fresh'"
                       decoration-warning="pharma_state == 'nearing_expiry'"
                       decoration-danger="pharma_state == 'expired'"/>
                <field name="is_pharma" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
