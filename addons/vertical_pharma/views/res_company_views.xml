<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_pharma" model="ir.ui.view">
        <field name="name">res.company.form.pharma</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Pharma Compliance" name="pharma_compliance"
                      groups="stock.group_stock_manager">
                    <group>
                        <group string="Expiry Alerts">
                            <field name="pharma_expiry_alert_days"/>
                        </group>
                        <group string="Delivery Policy">
                            <field name="pharma_expired_delivery_policy"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
