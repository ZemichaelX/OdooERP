<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- On screen, each Ethiopian date beside the Gregorian one it mirrors. -->
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.l10n.et.calendar</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_order']" position="after">
                <field name="l10n_et_date_order"
                       invisible="not l10n_et_date_order or state == 'purchase'"/>
            </xpath>
            <xpath expr="//div[@name='date_planned_div']" position="after">
                <field name="l10n_et_date_planned" invisible="not l10n_et_date_planned"/>
            </xpath>
        </field>
    </record>
</odoo>
