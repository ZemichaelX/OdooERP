<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- On screen: the Ethiopian date sits beside the Gregorian one it is
         derived from, read-only, and hides itself when there is nothing to
         show rather than printing an empty label. -->
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.l10n.et.calendar</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']/field[@name='date']" position="before">
                <field name="l10n_et_invoice_date" invisible="not l10n_et_invoice_date"/>
            </xpath>
            <xpath expr="//div[@name='due_date']" position="after">
                <field name="l10n_et_invoice_date_due" invisible="not l10n_et_invoice_date_due"/>
            </xpath>
        </field>
    </record>

    <!-- In the list, as an optional column: it sorts correctly because the
         stored form is canonical, so "order by Ethiopian date" is meaningful
         rather than alphabetical. -->
    <record id="view_out_invoice_tree" model="ir.ui.view">
        <field name="name">account.move.list.inherit.l10n.et.calendar</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <field name="invoice_date_due" position="after">
                <field name="l10n_et_invoice_date" string="Invoice Date (ET)" optional="hide"/>
            </field>
        </field>
    </record>
</odoo>
