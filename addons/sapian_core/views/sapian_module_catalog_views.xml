<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sapian_module_catalog_list" model="ir.ui.view">
        <field name="name">sapian.module.catalog.list</field>
        <field name="model">sapian.module.catalog</field>
        <field name="arch" type="xml">
            <list string="Module Catalog">
                <header>
                    <button name="action_sync_enabled" type="object"
                            string="Sync with Installed Modules"
                            display="always"
                            groups="base.group_system"/>
                </header>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="category"/>
                <field name="tier"/>
                <field name="enabled" readonly="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_sapian_module_catalog_form" model="ir.ui.view">
        <field name="name">sapian.module.catalog.form</field>
        <field name="model">sapian.module.catalog</field>
        <field name="arch" type="xml">
            <form string="Module Catalog Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="technical_name"/>
                            <field name="category"/>
                            <field name="tier"/>
                        </group>
                        <group>
                            <field name="enabled" readonly="1"/>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <!-- The bundle, visible. A consultant deciding what a client
                         gets must be able to see and edit inclusion without
                         reading the seed code. `required_by_ids` is the reverse
                         side, readonly: it answers "why did this get installed
                         when I did not pick it?" -->
                    <group string="Bundled modules">
                        <field name="requires_ids" widget="many2many_tags"
                               options="{'no_create': True}"
                               domain="[('company_id', '=', company_id), ('id', '!=', id)]"/>
                        <field name="required_by_ids" widget="many2many_tags"
                               readonly="1" invisible="not required_by_ids"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sapian_module_catalog_search" model="ir.ui.view">
        <field name="name">sapian.module.catalog.search</field>
        <field name="model">sapian.module.catalog</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="technical_name"/>
                <filter name="current_company" string="Current Company"
                        domain="[('company_id', 'in', [allowed_company_ids[0]])]"/>
                <filter name="enabled" string="Enabled"
                        domain="[('enabled', '=', True)]"/>
                <group>
                    <filter name="group_company" string="Company" domain="[]"
                            context="{'group_by': 'company_id'}"/>
                    <filter name="group_category" string="Category" domain="[]"
                            context="{'group_by': 'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sapian_module_catalog" model="ir.actions.act_window">
        <field name="name">Module Catalog</field>
        <field name="res_model">sapian.module.catalog</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sapian_module_catalog_search"/>
        <field name="context">{"search_default_current_company": 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Configure which product modules are enabled for this client.</p>
            <p>Enabled mirrors the installed modules (re-synced on upgrade);
               install additional modules through the Onboarding wizard.</p>
        </field>
    </record>

    <!-- web_icon is what makes this a TILE rather than a blank label. Without
         it, load_menus returns web_icon_data=False and the app drawer renders
         the name with no image at all (the <img> carries t-if="app.webIconData").
         Measured before this change: 21 root menus on the demo tenant, exactly
         one without an icon — this one. See brand/icons/README.md; the
         invariant is enforced by TestAppIconInvariant in sapian_core. -->
    <menuitem id="menu_sapian_root" name="SapianERP" sequence="5"
              web_icon="sapian_core,static/description/icon.png"/>
    <menuitem id="menu_sapian_config" name="Configuration" parent="menu_sapian_root" sequence="10"/>
    <menuitem id="menu_sapian_module_catalog" name="Module Catalog"
              parent="menu_sapian_config" action="action_sapian_module_catalog" sequence="10"/>
</odoo>
