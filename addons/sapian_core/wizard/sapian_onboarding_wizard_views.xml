<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sapian_onboarding_wizard_form" model="ir.ui.view">
        <field name="name">sapian.onboarding.wizard.form</field>
        <field name="model">sapian.onboarding.wizard</field>
        <field name="arch" type="xml">
            <form string="SapianERP Onboarding">
                <sheet>
                    <!-- Always visible, multi-company or not: users have
                         onboarded the wrong (placeholder) company because the
                         wizard silently targeted the active one. -->
                    <div class="alert alert-info" role="status">
                        <strong>You are onboarding:</strong>
                        <field name="company_id" class="oe_inline" options="{'no_create': True}"/>
                        — every setting below applies to this company.
                    </div>
                    <group>
                        <group string="Company Profile">
                            <field name="company_name"/>
                            <field name="tin"/>
                            <field name="street"/>
                            <field name="city"/>
                            <field name="fiscal_year"/>
                        </group>
                        <group string="Branding (light)">
                            <field name="logo" widget="image"
                                   class="oe_avatar"/>
                            <field name="primary_color" widget="color"/>
                        </group>
                    </group>
                    <group string="Modules">
                        <field name="module_catalog_ids" nolabel="1">
                            <list>
                                <field name="name"/>
                                <field name="technical_name"/>
                                <field name="category"/>
                                <field name="tier"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply &amp; Install" class="btn-primary"/>
                    <!-- Object button, not special=cancel: closing must land on
                         the apps home, never on a blank background. -->
                    <button name="action_cancel" type="object" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sapian_onboarding_wizard" model="ir.actions.act_window">
        <field name="name">Onboarding</field>
        <field name="res_model">sapian.onboarding.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Router: wizard only while the active company is not onboarded; the
         module catalog afterwards. Admin-only via the menu group. -->
    <record id="action_server_open_onboarding" model="ir.actions.server">
        <field name="name">Open Onboarding</field>
        <field name="model_id" ref="model_sapian_onboarding_wizard"/>
        <field name="state">code</field>
        <field name="code">action = env["sapian.onboarding.wizard"].action_open_onboarding()</field>
    </record>

    <menuitem id="menu_sapian_onboarding"
              name="Onboarding"
              parent="menu_sapian_config"
              action="action_server_open_onboarding"
              sequence="5"
              groups="base.group_system"/>
</odoo>
